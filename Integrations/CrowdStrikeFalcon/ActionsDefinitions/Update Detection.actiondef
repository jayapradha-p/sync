{"Name":"Update Detection","Description":"Deprecated. Update detection in Crowdstrike Falcon.","Script":"from SiemplifyAction import SiemplifyAction\nfrom SiemplifyUtils import output_handler\nfrom ScriptResult import EXECUTION_STATE_COMPLETED, EXECUTION_STATE_FAILED\n\nfrom TIPCommon.extraction import extract_configuration_param, extract_action_param\n\nfrom constants import (\n    INTEGRATION_NAME,\n    PRODUCT_NAME,\n    UPDATE_DETECTION_SCRIPT_NAME,\n    API_ROOT_DEFAULT,\n    DetectionStatusEnum,\n)\nfrom CrowdStrikeManager import CrowdStrikeManager\nfrom exceptions import CrowdStrikeParameterError\n\n\n@output_handler\ndef main():\n    siemplify = SiemplifyAction()\n    siemplify.script_name = UPDATE_DETECTION_SCRIPT_NAME\n\n    siemplify.LOGGER.info(\"----------------- Main - Param Init -----------------\")\n\n    api_root = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"API Root\",\n        default_value=API_ROOT_DEFAULT,\n    )\n    client_id = extract_configuration_param(\n        siemplify, provider_name=INTEGRATION_NAME, param_name=\"Client API ID\"\n    )\n    client_secret = extract_configuration_param(\n        siemplify, provider_name=INTEGRATION_NAME, param_name=\"Client API Secret\"\n    )\n    use_ssl = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"Verify SSL\",\n        input_type=bool,\n        is_mandatory=True,\n    )\n    customer_id = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"Customer ID\",\n        print_value=True,\n    )\n\n    detection_id = extract_action_param(\n        siemplify, param_name=\"Detection ID\", is_mandatory=True\n    )\n    status_to_update = extract_action_param(\n        siemplify, param_name=\"Status\", is_mandatory=True\n    )\n    assign_to = extract_action_param(siemplify, param_name=\"Assign Detection to\")\n\n    result_value = True\n    status = EXECUTION_STATE_COMPLETED\n\n    siemplify.LOGGER.info(\"----------------- Main - Started -----------------\")\n\n    try:\n        if status_to_update == DetectionStatusEnum.SELECT_ONE.value:\n            if not assign_to:\n                raise CrowdStrikeParameterError(\n                    'Either \"Status\" or \"Assign Detection To\" should have a proper value.'\n                )\n\n            status_to_update = None\n\n        manager = CrowdStrikeManager(\n            client_id=client_id,\n            client_secret=client_secret,\n            use_ssl=use_ssl,\n            api_root=api_root,\n            customer_id=customer_id,\n        )\n\n        uuid = manager.get_user_uuid_or_raise(assign_to) if assign_to else None\n\n        manager.update_detection(uuid, [detection_id], status_to_update)\n\n        output_message = (\n            f\"Successfully updated detection {detection_id} in {PRODUCT_NAME}.\"\n        )\n    except Exception as e:\n        output_message = (\n            f\"Error executing action '{UPDATE_DETECTION_SCRIPT_NAME}'. Reason: {e}\"\n        )\n        status = EXECUTION_STATE_FAILED\n        siemplify.LOGGER.error(output_message)\n        siemplify.LOGGER.exception(e)\n        result_value = False\n\n    siemplify.LOGGER.info(\"----------------- Main - Finished -----------------\")\n    siemplify.LOGGER.info(\n        f\"\\n  status: {status}\\n  is_success: {result_value}\\n  output_message: {output_message}\"\n    )\n    siemplify.end(output_message, result_value, status)\n\n\nif __name__ == \"__main__\":\n    main()\n","IntegrationIdentifier":"CrowdStrikeFalcon","ScriptResultName":"is_success","DynamicResultsMetadata":null,"Creator":"Admin","IsEnabled":true,"IsCustom":true,"AiGenerated":false,"IsSystem":false,"Version":1.0,"TimeoutSeconds":600,"IsAsync":null,"AsyncPollingIntervalInSeconds":300,"TotalIntervalTimeoutForAsyncInSeconds":3600,"Parameters":[{"CustomActionId":0,"IsMandatory":true,"DefaultValue":"","Description":"Specify the ID of the detection that needs to be updated.","Name":"Detection ID","Value":"","Type":0,"OptionalValues":null,"OptionalValuesJson":null},{"CustomActionId":0,"IsMandatory":true,"DefaultValue":"Select One","Description":"Specify the new status for the detection.","Name":"Status","Value":"","Type":15,"OptionalValues":["new","in_progress","true_positive","false_positive","ignored","closed","Select One"],"OptionalValuesJson":"[\"new\",\"in_progress\",\"true_positive\",\"false_positive\",\"ignored\",\"closed\",\"Select One\"]"},{"CustomActionId":0,"IsMandatory":false,"DefaultValue":"","Description":"Specify the email address of the Crowdstrike Falcon user, who needs to be assigned to this detection","Name":"Assign Detection to","Value":"","Type":0,"OptionalValues":null,"OptionalValuesJson":null}],"DefaultResultValue":"","PythonVersion":"None","ActionType":1,"SimulationData":{"Entities":null},"SimulationDataJson":null,"AICategories":[],"AIDescription":"### General Description\nUpdates the status and/or the assigned user for specific detections within the CrowdStrike Falcon platform. This action allows analysts to manage the lifecycle of detections directly from Google SecOps by modifying their current state or reassigning them to different team members.\n\n### Parameters Description\n| Parameter | Type | Mandatory | Description |\n| :--- | :--- | :--- | :--- |\n| Detection IDs | String | Yes | A comma-separated list of unique CrowdStrike Detection IDs to be updated. |\n| Status | String | No | The new status to apply to the detections. Common values include 'new', 'in_progress', 'true_positive', 'false_positive', and 'ignored'. |\n| Assign To | String | No | The email address of the CrowdStrike Falcon user to whom the detections should be assigned. |\n\n### Additional Notes\nAt least one of the optional parameters ('Status' or 'Assign To') must be provided for the action to perform a meaningful update. If 'Assign To' is provided, the action will first attempt to resolve the email address to a CrowdStrike User UUID.\n\n### Flow Description\n1. **Initialization**: The action extracts the provided Detection IDs, target Status, and Assignee email from the input parameters.\n2. **User Resolution**: If an email is specified in the 'Assign To' field, the action calls the CrowdStrike API to retrieve the internal UUID associated with that email address.\n3. **API Request**: The action constructs a PATCH request containing the list of Detection IDs and the updated fields (status and/or assigned_to_uuid).\n4. **Execution**: The request is sent to the CrowdStrike `/detects/entities/detects/v2` endpoint.\n5. **Finalization**: The action reports the success or failure of the update operation for the specified detections.","EntityTypes":[]}