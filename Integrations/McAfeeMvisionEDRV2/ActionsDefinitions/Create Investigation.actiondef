        },
        {
            "isMandatory": true,
            "isAdvanced": false,
            "name": "Result Json Example",
            "defaultValue": "[{\"Entity\": \"1.1.1.1\", \"EntityResult\": {\"type\": \"investigations\", \"id\": \"05cae9b0-24ca-11eb-b713-000000000000\", \"attributes\": {\"created\": \"2020-11-12T09:32:46.411Z\", \"lastModified\": \"2020-11-12T09:32:46.411Z\", \"name\": \"Siemplify Test\", \"owner\": \"unknown\", \"summary\": \"\", \"source\": \"unknown\", \"isAutomatic\": true, \"hint\": \"Test\", \"caseType\": \"IOC\", \"investigated\": true, \"status\": \"In progress\", \"priority\": \"High\"}}}]",
            "type": 2,
